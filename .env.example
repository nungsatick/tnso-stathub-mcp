# Override the SDMX 2.1 REST data/structure endpoint (default: ns2-stathub.nso.go.th).
# TNSO_BASE_URL=https://ns2-stathub.nso.go.th/rest

# Override the Fusion Metadata Registry endpoint (structure queries only).
# TNSO_REGISTRY_BASE_URL=https://sdmx.nso.go.th/FusionMetadataRegistry/sdmx/v2

# Override the agency id used in query paths (default: TNSO).
# TNSO_AGENCY_ID=TNSO

# Request timeout in seconds (default: 30).
# TNSO_TIMEOUT_SECONDS=30

# Disable the local TNSO SQLite cache. Use this when pointing the server at a
# different SDMX endpoint so cached TNSO metadata cannot be returned.
# SDMX_DISABLE_CACHE=1

# Only needed if NSO introduces API authentication in the future.
# As of writing, ns2-stathub.nso.go.th/rest is publicly accessible without a key.
# TNSO_API_KEY=

# HTTP transport settings (only used with --transport http)
# HOST=0.0.0.0
# PORT=8000
